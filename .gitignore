# 依存パッケージ（npm install で復元できるためコミットしない）
node_modules/

# ビルド成果物
dist/
release/
out/

# ログ・一時ファイル
*.log
npm-debug.log*
.cache/
.tmp/

# OS / エディタ
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# 環境変数（APIキーなど）
.env
.env.*
!.env.example

# AI指示ファイル
CLAUDE.md

# ユーザーが用意するコンテンツ（音源・動画・スライドなど）。フォルダだけ残す
contents/*
!contents/.gitkeep
